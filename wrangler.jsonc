{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "51vipai",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-23",
  "routes": [
    {
      "pattern": "www.51vipai.com/api/*",
      "zone_name": "51vipai.com"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "51vipai-etf"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
